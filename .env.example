# GigaChat API — обязательные переменные
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_CA_BUNDLE_FILE=certs/russian_trusted_root_ca_pem.crt
GIGACHAT_VERIFY_SSL_CERTS=True

# Таймаут одного запроса, секунды.
# У SDK по умолчанию 30 — для документа на несколько тысяч символов
# с JSON Schema этого не хватает, и запрос падает с read timeout.
GIGACHAT_TIMEOUT=120

# Сколько раз повторять запрос при 429 и 5xx (0 — не повторять).
# Повторы делает сам SDK и уважает Retry-After у 429.
GIGACHAT_MAX_RETRIES=1

# Django — на будущее, для деплоя
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
